[gd_scene load_steps=2 format=3 uid="uid://mini_game_dock"]

[ext_resource type="Script" path="res://addons/godot_mini_game/export_dock.gd" id="1"]

[node name="MiniGameExport" type="VBoxContainer"]
custom_minimum_size = Vector2(300, 0)
script = ExtResource("1")

[node name="Title" type="Label" parent="."]
text = "小游戏导出"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 18

[node name="Sep0" type="HSeparator" parent="."]

[node name="PlatformLabel" type="Label" parent="."]
text = "目标平台"

[node name="PlatformOption" type="OptionButton" parent="."]

[node name="AppIdLabel" type="Label" parent="."]
text = "App ID / Client Key"

[node name="AppIdInput" type="LineEdit" parent="."]
placeholder_text = "填写项目 App ID；TikTok Client Key 还需 ttmg init"

[node name="OrientationLabel" type="Label" parent="."]
text = "屏幕方向"

[node name="OrientationOption" type="OptionButton" parent="."]

[node name="PresetLabel" type="Label" parent="."]
text = "Web 导出预设"

[node name="PresetOption" type="OptionButton" parent="."]

[node name="Sep1" type="HSeparator" parent="."]

[node name="OutputLabel" type="Label" parent="."]
text = "输出目录"

[node name="OutputRow" type="HBoxContainer" parent="."]

[node name="OutputPath" type="LineEdit" parent="OutputRow"]
size_flags_horizontal = 3
placeholder_text = "选择导出目录"

[node name="BrowseBtn" type="Button" parent="OutputRow"]
text = "..."

[node name="Sep2" type="HSeparator" parent="."]

[node name="TemplateLabel" type="Label" parent="."]
text = "引擎模板"

[node name="TemplateStatus" type="RichTextLabel" parent="."]
custom_minimum_size = Vector2(0, 40)
bbcode_enabled = true
fit_content = true
scroll_active = false

[node name="TemplateRow" type="HBoxContainer" parent="."]

[node name="DownloadBtn" type="Button" parent="TemplateRow"]
visible = false
size_flags_horizontal = 3
text = "下载匹配模板"

[node name="ImportBtn" type="Button" parent="TemplateRow"]
size_flags_horizontal = 3
text = "导入引擎模板..."

[node name="RefreshBtn" type="Button" parent="TemplateRow"]
text = "刷新"

[node name="TemplateHint" type="Label" parent="."]
autowrap_mode = 2
theme_override_font_sizes/font_size = 11
text = "需要与当前编辑器精确匹配的小游戏模板。已认证的版本可一键下载；其它版本可从本项目 Releases 下载，或自行编译。"

[node name="Sep3" type="HSeparator" parent="."]

[node name="ExportBtn" type="Button" parent="."]
custom_minimum_size = Vector2(0, 40)
text = "导出小游戏"

[node name="CancelExportBtn" type="Button" parent="."]
visible = false
disabled = true
text = "取消导出"

[node name="TimeoutRow" type="HBoxContainer" parent="."]

[node name="TimeoutLabel" type="Label" parent="TimeoutRow"]
text = "资源导出超时（秒）"

[node name="TimeoutInput" type="SpinBox" parent="TimeoutRow"]
size_flags_horizontal = 3
min_value = 1.0
max_value = 86400.0
value = 600.0
tooltip_text = "Godot 资源打包子进程的最长等待时间；超时后停止本次导出。"

[node name="StatusLabel" type="RichTextLabel" parent="."]
custom_minimum_size = Vector2(0, 120)
bbcode_enabled = true
scroll_following = true

[node name="FolderDialog" type="FileDialog" parent="."]
title = "选择输出目录"
size = Vector2i(600, 400)
access = 2
file_mode = 2

[node name="TemplateFileDialog" type="FileDialog" parent="."]
title = "选择引擎模板 ZIP"
size = Vector2i(600, 400)
access = 2
file_mode = 0
filters = PackedStringArray("*.zip ; ZIP 文件")
